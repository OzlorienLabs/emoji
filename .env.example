# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# --- Footer feedback form (server-side only, never exposed to the browser) ---
# Resend API key used by api/feedback.ts to relay notes from the footer modal.
# Leave blank and the form reports that feedback is not configured yet.
RESEND_API_KEY=
# Where those notes land. Defaults to ozlorienlabs@gmail.com when unset.
FEEDBACK_TO=ozlorienlabs@gmail.com
# Verified Resend sender. Defaults to Resend's shared test sender when unset.
FEEDBACK_FROM=Emoji Compass <onboarding@resend.dev>
